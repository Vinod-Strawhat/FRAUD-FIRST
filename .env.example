# ─────────────────────────────────────────────────────────────
# FraudFirst — Environment configuration
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials or secrets to source control.
# All values below are safe, non-secret defaults for development.
# ─────────────────────────────────────────────────────────────

# Public app origin used for canonical URLs / links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime environment ("development" | "production").
NEXT_PUBLIC_APP_ENV=development

# ─────────────────────────────────────────────────────────────
# AWS Textract — evidence text extraction (Task 4, SERVER-SIDE ONLY).
# Never expose these through NEXT_PUBLIC_* variables.
# If these are missing, /api/evidence/extract returns
# AWS_NOT_CONFIGURED and the UI shows "AWS processing unavailable".
# ─────────────────────────────────────────────────────────────
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Alternative to static keys: rely on a named profile from the shared config.
# When using a profile, set it here instead of the static keys above.
# AWS_PROFILE=default

# ─────────────────────────────────────────────────────────────
# S3 — original evidence preservation (Task 5, SERVER-SIDE ONLY).
# The private bucket that stores the exact original bytes for each
# evidence item. If missing, /api/evidence/upload returns
# BUCKET_NOT_CONFIGURED and the UI shows "Evidence bucket unavailable".
# Create a PRIVATE bucket (never public) and reference its name here.
# ─────────────────────────────────────────────────────────────
# FRAUDFIRST_EVIDENCE_BUCKET=fraudfirst-evidence

# ─────────────────────────────────────────────────────────────
# Amazon Bedrock — AI-assisted evidence correlation (Task 6, SERVER-SIDE ONLY).
# The foundation model ID used by /api/evidence/correlate. The model must
# be available and model-access enabled in the AWS_REGION used above.
# If missing, /api/evidence/correlate returns BEDROCK_NOT_CONFIGURED and
# the UI shows the correlation action as unavailable. NEVER expose this
# through NEXT_PUBLIC_* variables — the model id stays server-side.
# ─────────────────────────────────────────────────────────────
# FRAUDFIRST_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ─────────────────────────────────────────────────────────────
# OpenRouter — fallback AI correlation provider (SERVER-SIDE ONLY).
# Used when Bedrock is unavailable. Requires an API key from openrouter.ai.
# NEVER expose this through NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=your-openrouter-api-key
# FRAUDFIRST_OPENROUTER_MODEL_ID=meta-llama/llama-4-maverick

# ─────────────────────────────────────────────────────────────
# DynamoDB — incident workspace persistence (Task 7, SERVER-SIDE ONLY).
# One table for structured incident metadata/state (incident, evidence
# metadata, timeline, next-action). Raw evidence stays in S3 and raw
# OCR text is never stored here. If missing, /api/incidents/[id] returns
# DYNAMODB_NOT_CONFIGURED and the UI shows "Local session". NEVER expose
# the table name or any AWS setting through NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────
# FRAUDFIRST_DYNAMODB_TABLE=fraudfirst-incidents

# ─────────────────────────────────────────────────────────────
# Step Functions — time-aware response orchestration (Task 8, SERVER-SIDE ONLY).
# The Standard workflow that sequences the guided response plan
# (INCIDENT_STARTED → PRESERVE_EVIDENCE → CONTACT_BANK → CONTACT_1930 →
# REPORT_CYBERCRIME → FOLLOW_UP → RESPONSE_COMPLETE). Execution input carries
# only safe incident metadata (incidentId, startedAt, currentAction,
# amount, currency) - never raw evidence, OCR text, credentials, or
# unnecessary PII. If missing, /api/incidents/[id]/response/start returns
# STEP_FUNCTIONS_NOT_CONFIGURED and the response plan stays unstarted.
# The workflow never performs external actions automatically; each step is
# a pending action the user must explicitly mark complete.
# ─────────────────────────────────────────────────────────────
# FRAUDFIRST_STEP_FUNCTIONS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:ACCOUNT_ID:stateMachine:FraudFirstResponseWorkflow